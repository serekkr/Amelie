# Sicurezza supply-chain: non eseguire MAI gli script di lifecycle
# (preinstall/install/postinstall/prepare) delle dipendenze durante npm install.
# Le dipendenze di Amelie sono JS puro o hanno già i binari prebuilt, quindi
# questo non rompe build né avvio. Vale solo per questo progetto.
#
# NB: se reinstalli da zero (rm -rf node_modules) e il binario di Electron
# dovesse mancare, lancialo a mano e visibile:  node node_modules/electron/install.js
ignore-scripts=true
