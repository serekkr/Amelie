# Supply-chain hardening: NEVER run dependencies' lifecycle scripts
# (preinstall/install/postinstall/prepare) during npm install.
# Amelie's dependencies are pure JS or already ship prebuilt binaries, so
# this breaks neither the build nor startup. Applies to this project only.
#
# NOTE: if you reinstall from scratch (rm -rf node_modules) and Electron's
# binary is missing, run it manually and visibly:  node node_modules/electron/install.js
ignore-scripts=true
