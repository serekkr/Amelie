{
  "name": "amelie",
  "version": "1.0.39",
  "description": "Amelie — Your data, private by default",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:cm": "esbuild build/cm-entry.js --bundle --format=iife --outfile=src/renderer/vendor/cm.bundle.js --legal-comments=none",
    "build": "electron-builder --linux AppImage --x64",
    "build:linux": "electron-builder --linux AppImage --x64",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:excalidraw": "esbuild build/excalidraw-entry.js --bundle --format=iife --outfile=src/renderer/excalidraw-bundle.js --minify --legal-comments=none --conditions=production --define:process.env.NODE_ENV=\\\"production\\\" --loader:.woff2=empty --loader:.png=empty --loader:.svg=empty && node build/scrub-bundle.js",
    "test": "node test/editor-desync.test.mjs && node test/backup-destinations.test.mjs && node test/backup-catchup.test.mjs && node test/preview-code-untouched.test.mjs && node test/media-in-folders.test.mjs",
    "test:app": "node test/editor-typing.cdp.mjs",
    "test:sweep": "node test/editor-wrap-sweep.mjs",
    "test:enc": "node test/editor-encrypted.cdp.mjs",
    "test:backup": "node test/backup-restore.cdp.mjs",
    "test:attach": "node test/attachment-gate.cdp.mjs",
    "test:media": "node test/media-opens-note.cdp.mjs",
    "test:media-lazy": "node test/media-server-lazy.cdp.mjs",
    "test:paste": "node test/paste-fidelity.cdp.mjs",
    "test:temps": "node test/attachment-temps-hidden.cdp.mjs",
    "test:drop": "node test/sidebar-media-drop.cdp.mjs",
    "test:rename": "node test/attachment-rename.cdp.mjs",
    "test:mediatab": "node test/media-tab-plays.cdp.mjs",
    "test:notemedia": "node test/note-media-plays.cdp.mjs",
    "test:nav": "node test/note-nav.cdp.mjs",
    "test:hl": "node test/highlight-worker.cdp.mjs",
    "test:newfolder": "node test/new-folder-rename.cdp.mjs",
    "test:drawcpu": "node test/draw-idle-cpu.cdp.mjs"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "pdf-lib": "^1.17.1",
    "tar": "^7.5.22",
    "webdav": "^5.5.0"
  },
  "build": {
    "icon": "assets/icon.png",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/rsync",
        "to": "rsync"
      },
      {
        "from": "smb-helper/amelie-smb",
        "to": "amelie-smb"
      }
    ]
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@excalidraw/excalidraw": "^0.18.1",
    "electron": "^42.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "webdav": {
      "minimatch": "^10.2.5"
    },
    "brace-expansion@^1.0.0": "^1.1.17",
    "brace-expansion@^2.0.0": "^2.1.3",
    "brace-expansion@^5.0.0": "^5.0.9",
    "lodash-es": "^4.18.1",
    "nanoid@^3.0.0": "^3.3.8",
    "nanoid@^4.0.0": "^5.0.9"
  }
}
