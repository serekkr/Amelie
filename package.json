{
  "name": "amelie",
  "version": "1.0.2",
  "description": "Amelie — Your data, private by default",
  "main": "src/main/main.js",
  "scripts": {
    "build:cm": "esbuild build/cm-entry.js --bundle --format=iife --outfile=src/renderer/vendor/cm.bundle.js --legal-comments=none"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "tar": "^7.5.15",
    "webdav": "^5.5.0"
  },
  "build": {
    "icon": "assets/icon.png",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/rsync",
        "to": "rsync"
      },
      {
        "from": "smb-helper/amelie-smb",
        "to": "amelie-smb"
      }
    ]
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.5",
    "@electron/asar": "^4.2.0",
    "codemirror": "^6.0.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  }
}
